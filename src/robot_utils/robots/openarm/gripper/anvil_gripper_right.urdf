<?xml version="1.0"?>
<!-- Anvil's Customizable Gripper on the right arm (fine tips), in our end_link convention: end_link at the fingertips, midway between the jaws, x out of the fingertips, z toward the wrist camera; finger_left / finger_right prismatic along end_link y. The hand's and fingers' visual meshes, masses and inertias are Anvil's (the gripper's CAD is public); the collision geometry is the gripper type's boxes (robots/grippers.py anvil). build_urdf.py mounts it on joint 7 (README.md). Mesh paths relative to this file. -->
<robot name="anvil_gripper_right">
  <link name="end_link">
    <inertial>
      <origin xyz="-0.0725 -0.002 0" rpy="0 0 0" />
      <mass value="0.7" />
      <inertia ixx="0.0002521" ixy="-1e-06" ixz="1e-06" iyy="1.763e-05" iyz="-1e-06" izz="0.0002473" />
    </inertial>
    <visual name="right_hand_anodized_black_visual">
      <origin xyz="-0.1025 0 0" rpy="-3.14159265 -1.57079633 0" />
      <geometry>
        <mesh filename="meshes/hand_anodized_black.obj" />
      </geometry>
      <material name="anodized_black">
        <color rgba="0.11 0.11 0.115 1" />
      </material>
    </visual>
    <visual name="right_hand_camera_gray_visual">
      <origin xyz="-0.1025 0 0" rpy="-3.14159265 -1.57079633 0" />
      <geometry>
        <mesh filename="meshes/hand_camera_gray.stl" />
      </geometry>
      <material name="gray_175">
        <color rgba="0.686275 0.686275 0.686275 1" />
      </material>
    </visual>
    <collision name="end_link_gripper_housing">
      <origin xyz="-0.13085 -0.0011 0.0002" rpy="0 0 0" />
      <geometry>
        <box size="0.0417 0.057 0.057" />
      </geometry>
    </collision>
    <collision name="end_link_gripper_guide">
      <origin xyz="-0.09755 -0.0011 0.0002" rpy="0 0 0" />
      <geometry>
        <box size="0.0249 0.108 0.057" />
      </geometry>
    </collision>
    <collision name="end_link_wrist_camera_arm">
      <origin xyz="-0.1405 0 0.0455" rpy="0 0 0" />
      <geometry>
        <box size="0.067 0.038 0.041" />
      </geometry>
    </collision>
    <collision name="end_link_wrist_camera">
      <origin xyz="-0.1025 0 0.0865" rpy="0 0 0" />
      <geometry>
        <box size="0.041 0.038 0.041" />
      </geometry>
    </collision>
  </link>
  <link name="finger_left_link">
    <inertial>
      <origin xyz="-0.0655315 0.02302 0.0064528" rpy="0 0 0" />
      <mass value="0.03602545343277134" />
      <inertia ixx="9.927e-06" ixy="3.509e-06" ixz="2.792e-06" iyy="1.976e-05" iyz="-7.351e-07" izz="1.444e-05" />
    </inertial>
    <visual name="right_right_finger_dark_visual">
      <origin xyz="-0.0875 0.006 0" rpy="-3.14159265 -1.57079633 0" />
      <geometry>
        <mesh filename="meshes/right_finger_dark.stl" />
      </geometry>
      <material name="dark_60">
        <color rgba="0.235294 0.235294 0.235294 1" />
      </material>
    </visual>
    <visual name="right_right_finger_fine_tip_dark_visual">
      <origin xyz="-0.0875 0.006 0" rpy="-3.14159265 -1.57079633 0" />
      <geometry>
        <mesh filename="meshes/right_finger_fine_tip_dark.stl" />
      </geometry>
      <material name="dark_60">
        <color rgba="0.235294 0.235294 0.235294 1" />
      </material>
    </visual>
    <collision name="finger_left_link_jaw_root">
      <origin xyz="-0.0885 0.01625 0.00495" rpy="0 0 0" />
      <geometry>
        <box size="0.0202 0.0325 0.0355" />
      </geometry>
    </collision>
    <collision name="finger_left_link_jaw">
      <origin xyz="-0.02 0.0045 -0.0055" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.009 0.0386" />
      </geometry>
    </collision>
    <collision name="finger_left_link_jaw_back">
      <origin xyz="-0.0592 0.01685 -0.0003" rpy="0 0 0" />
      <geometry>
        <box size="0.0384 0.0317 0.049" />
      </geometry>
    </collision>
  </link>
  <link name="finger_right_link">
    <inertial>
      <origin xyz="-0.0655315 -0.02302 0.0064528" rpy="0 0 0" />
      <mass value="0.03602545343277134" />
      <inertia ixx="9.827e-06" ixy="-3.51e-06" ixz="2.43e-06" iyy="1.966e-05" iyz="7.397e-07" izz="1.445e-05" />
    </inertial>
    <visual name="right_left_finger_dark_visual">
      <origin xyz="-0.0875 -0.006 0" rpy="-3.14159265 -1.57079633 0" />
      <geometry>
        <mesh filename="meshes/left_finger_dark.stl" />
      </geometry>
      <material name="dark_60">
        <color rgba="0.235294 0.235294 0.235294 1" />
      </material>
    </visual>
    <visual name="right_left_finger_fine_tip_dark_visual">
      <origin xyz="-0.0875 -0.006 0" rpy="-3.14159265 -1.57079633 0" />
      <geometry>
        <mesh filename="meshes/left_finger_fine_tip_dark.stl" />
      </geometry>
      <material name="dark_60">
        <color rgba="0.235294 0.235294 0.235294 1" />
      </material>
    </visual>
    <collision name="finger_right_link_jaw_root">
      <origin xyz="-0.0885 -0.01625 0.00495" rpy="0 0 0" />
      <geometry>
        <box size="0.0202 0.0325 0.0355" />
      </geometry>
    </collision>
    <collision name="finger_right_link_jaw">
      <origin xyz="-0.02 -0.0045 -0.0055" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.009 0.0386" />
      </geometry>
    </collision>
    <collision name="finger_right_link_jaw_back">
      <origin xyz="-0.0592 -0.01685 -0.0003" rpy="0 0 0" />
      <geometry>
        <box size="0.0384 0.0317 0.049" />
      </geometry>
    </collision>
  </link>
  <joint name="finger_left" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="end_link" />
    <child link="finger_left_link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.05" effort="10" velocity="1" />
  </joint>
  <joint name="finger_right" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="end_link" />
    <child link="finger_right_link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.05" upper="0" effort="10" velocity="1" />
    <mimic joint="finger_left" multiplier="-1" offset="0" />
  </joint>
</robot>
