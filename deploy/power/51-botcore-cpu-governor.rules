// robot_utils power node: let botcore (the robot's nodes) set the CPU governor without sudo, and nothing else:
// only start/restart of robot-cpu-governor@<lowercase name>.service, which validates the name itself.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "botcore") {
        var unit = action.lookup("unit") || "";
        var verb = action.lookup("verb") || "";
        if (/^robot-cpu-governor@[a-z]+\.service$/.test(unit) && (verb == "start" || verb == "restart")) {
            return polkit.Result.YES;
        }
    }
});
